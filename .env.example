# ==============================================================================
# DataTrust - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env files containing real secrets to version control.
# ==============================================================================

# Application Metadata & Runtime
ENVIRONMENT=development
PROJECT_NAME="DataTrust API"

# PostgreSQL Database Connection
# Local Docker: postgresql://datatrust_user:datatrust_password@postgres:5432/datatrust_db
# Local Native: postgresql://datatrust_user:datatrust_password@localhost:5432/datatrust_db
# Cloud Managed (Neon/Render/Railway): postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://datatrust_user:datatrust_password@localhost:5432/datatrust_db

# PostgreSQL Credentials (for Docker Compose database service)
POSTGRES_USER=datatrust_user
POSTGRES_PASSWORD=datatrust_password
POSTGRES_DB=datatrust_db

# JWT Authentication
# In production, generate a secure random 32+ character key
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
# Include your frontend URL (e.g. Vercel deployment URL in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend API Target URL (used by browser to reach FastAPI)
# Local Docker/Dev: http://localhost:8000
# Cloud Production: https://api.yourdomain.com or https://datatrust-backend.onrender.com
VITE_API_URL=http://localhost:8000

# File Ingestion & Storage Limits
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE_MB=50

# Google Gemini AI Diagnostics (Optional - required for on-demand AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
