# ==============================================================================
# DataTrust - Frontend Environment Variables
# Copy to frontend/.env for local standalone frontend execution
# ==============================================================================

# API Base URL (used by browser to reach FastAPI backend)
# Local Development / Local Docker: http://localhost:8000
# Production: Set to your deployed backend URL (e.g., https://datatrust-api.onrender.com)
VITE_API_URL=http://localhost:8000
