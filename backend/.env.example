# ==============================================================================
# DataTrust - Backend Environment Variables
# Copy to backend/.env for local standalone backend execution
# ==============================================================================

PROJECT_NAME="DataTrust API"
ENVIRONMENT=development

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://datatrust_user:datatrust_password@localhost:5432/datatrust_db

# JWT Authentication (supports both JWT_SECRET_KEY and JWT_SECRET)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Storage & File Ingestion
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=../data/uploads

# Cloud Object Storage (Supabase Storage - Persists datasets across Render restarts)
# Optional in local development (falls back to local filesystem); Recommended for Render production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datatrust-datasets

# Google Gemini AI Diagnostics (Optional - required for on-demand AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
