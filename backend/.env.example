# DataTrust Backend Environment Variables
PROJECT_NAME="DataTrust API"
ENVIRONMENT=development

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://datatrust_user:datatrust_password@localhost:5432/datatrust_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage & File Ingestion
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=../data/uploads
